<Window x:Class="SnapKeyLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="SnapKey Launcher" Height="380" Width="500"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel Margin="24">

            <!-- Заголовок -->
            <TextBlock Text="SnapKey" FontSize="28" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock x:Name="StatusText" FontSize="13" Foreground="#888" Margin="0,0,0,28"/>

            <!-- Установить -->
            <Border x:Name="InstallBorder" CornerRadius="8" Margin="0,0,0,8" Cursor="Hand"
                    MouseDown="InstallClick">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         To="0.9" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Background>#1A3A5C</Border.Background>
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Install" FontSize="15" FontWeight="SemiBold" x:Name="InstallText" Foreground="#5BB3FF"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Download and install SnapKey on this machine."
                               TextWrapping="Wrap" Foreground="#888" VerticalAlignment="Center" FontSize="12"/>
                </Grid>
            </Border>

            <!-- Обновить -->
            <Border x:Name="UpdateBorder" CornerRadius="8" Margin="0,0,0,8" Cursor="Hand"
                    MouseDown="UpdateClick">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         To="0.9" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Update" FontSize="15" FontWeight="SemiBold" x:Name="UpdateLabel"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Download and install the latest version."
                               TextWrapping="Wrap" Foreground="#888" VerticalAlignment="Center" FontSize="12"/>
                </Grid>
            </Border>

            <!-- Исправить -->
            <Border x:Name="RepairBorder" CornerRadius="8" Margin="0,0,0,8" Cursor="Hand"
                    MouseDown="RepairClick">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         To="0.9" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Repair" FontSize="15" FontWeight="SemiBold" x:Name="RepairLabel"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Reinstall files without changing your settings."
                               TextWrapping="Wrap" Foreground="#888" VerticalAlignment="Center" FontSize="12"/>
                </Grid>
            </Border>

            <!-- Удалить -->
            <Border x:Name="UninstallBorder" CornerRadius="8" Cursor="Hand"
                    MouseDown="UninstallClick">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         To="0.9" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Uninstall" FontSize="15" FontWeight="SemiBold" x:Name="UninstallLabel"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Remove SnapKey and all its components."
                               TextWrapping="Wrap" Foreground="#888" VerticalAlignment="Center" FontSize="12"/>
                </Grid>
            </Border>

        </StackPanel>
    </Grid>
</Window>