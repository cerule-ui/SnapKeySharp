<Window x:Class="SnapKeyLauncher.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="SnapKey Launcher" Height="200" Width="480"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBlock x:Name="StepText" Foreground="#888" FontSize="13" Margin="0,0,0,20"/>

            <ProgressBar x:Name="ProgressBar" Height="6" Minimum="0" Maximum="100"
                         Value="0" Margin="0,0,0,12"/>

            <Grid>
                <TextBlock x:Name="PercentText" Text="0%" Foreground="#888" FontSize="12"
                           HorizontalAlignment="Left"/>
                <Button x:Name="CancelBtn" Content="Cancel" HorizontalAlignment="Right"
                        Click="CancelClick" Padding="16,4"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>