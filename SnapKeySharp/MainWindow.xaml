<Window x:Class="SnapKeySharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:SnapKeySharp"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="SnapKey • by cerule" Height="520" Width="380"
        ResizeMode="NoResize" Icon="assets/icon.ico">
    <Grid>
        <tb:TaskbarIcon x:Name="TrayIcon" 
                IconSource="/Assets/icon.ico"
                ToolTipText="SnapKey"
                TrayLeftMouseDown="TrayIcon_Click">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{DynamicResource TrayOpen}" Click="TrayIcon_Click"/>
                    <MenuItem Header="{DynamicResource TrayAutoStart}" IsCheckable="True" 
                        x:Name="AutoStartMenuItem" Click="TrayAutoStart_Click"/>
                    <MenuItem Header="{DynamicResource TrayWorking}" IsCheckable="True"
                              x:Name="WorkingMenuItem" Click="TrayWorking_Click"/>
                    <MenuItem Header="{DynamicResource TrayExit}" Click="TrayExit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
        <StackPanel Margin="16">
            <!-- Статус -->
            <Border Background="#1e221e" 
        CornerRadius="10" 
        Padding="20,14" 
        Margin="0,0,0,16" x:Name="BorderStatus">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая часть: статус -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Индикатор с glow-эффектом -->
                        <Grid Margin="0,0,12,0" VerticalAlignment="Center">
                            <!-- Размытое свечение вокруг точки -->
                            <Ellipse Width="17" Height="18" Fill="#4CAF50" Opacity="0.20" x:Name="StatusDotFlow"/>
                            <!-- Сама точка с пульсацией -->
                            <Ellipse x:Name="StatusDot" 
                         Width="9" Height="9" 
                         Fill="#4CAF50" 
                         VerticalAlignment="Center" 
                         HorizontalAlignment="Center">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="1" To="0.35" 
                                                     Duration="0:0:1.5" 
                                                     AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        </Grid>

                        <!-- Текст статуса: подпись + значение -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Status}" 
                           FontSize="11" 
                           Foreground="#808080" 
                           Margin="0,0,0,0"/>
                            <TextBlock x:Name="StatusText" 
                           Text="{DynamicResource StatusActive}" 
                           FontSize="18" 
                           FontWeight="SemiBold" 
                           Foreground="#F0F0F0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Правая часть: кнопка -->
                    <ui:AppBarButton Grid.Column="2" Icon="Pause" x:Name="ToggleButton"
                 Label="{DynamicResource BtnPause}" Click="ToggleButtonClick" 
                 Margin="0,0,0,0"/>
                </Grid>
            </Border>

            <!-- Пары -->
            <Border Background="#252525" Padding="0,0,0,8" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource PairsHeader}" 
                   FontWeight="SemiBold" Margin="20,16,0,8"/>
                    <Button Grid.Row="0" Grid.Column="1" Content="{DynamicResource AddPair}" 
                Margin="0,8,20,0" VerticalAlignment="Top" Click="AddPairClick"/>

                    <!-- Горизонтальная полоска-разделитель -->
                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                Height="1" 
                Background="#3E3E3E" 
                Margin="0,0,0,0" Opacity="0" x:Name="PairsHorizontalLine"/>

                    <ScrollViewer Grid.Row="2" Grid.ColumnSpan="2" MaxHeight="80" 
                      VerticalScrollBarVisibility="Auto" Padding="12,0,0,0">
                        <StackPanel x:Name="PairsPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Исключения -->
            <Border Background="#252525" Padding="0,0,0,8" Margin="0,12,0,0" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource ExclusionsHeader}" 
                   FontWeight="SemiBold" Margin="20,16,0,8"/>
                    <Button Grid.Row="0" Grid.Column="1" Content="{DynamicResource AddExclusion}" 
                Margin="0,8,20,0" VerticalAlignment="Top" Click="AddExclusionClick"/>

                    <!-- Горизонтальная полоска-разделитель -->
                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                Height="1" 
                Background="#3E3E3E" 
                Margin="0,0,0,0" Opacity="0" x:Name="ExclusionsHorizontalLine"/>

                    <ScrollViewer Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                      MaxHeight="110" 
                      VerticalScrollBarVisibility="Auto" 
                      Padding="12,0,0,0" Margin="0,0,0,0">
                        <StackPanel x:Name="ExclusionsPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>

        </StackPanel>

        <!-- Версия -->
        <TextBlock x:Name="versionText" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5" Foreground="DarkGray"/>
    </Grid>
</Window>
