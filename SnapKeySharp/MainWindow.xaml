<Window x:Class="SnapKeySharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:SnapKeySharp"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="SnapKey • by cerule" Height="520" Width="380"
        ResizeMode="NoResize" Icon="assets/icon.ico">
    <Grid>
        <tb:TaskbarIcon x:Name="TrayIcon" 
                IconSource="/Assets/icon.ico"
                ToolTipText="SnapKey"
                TrayLeftMouseDown="TrayIcon_Click">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{DynamicResource TrayOpen}" Click="TrayIcon_Click"/>
                    <MenuItem Header="{DynamicResource TrayAutoStart}" IsCheckable="True" 
                        x:Name="AutoStartMenuItem" Click="TrayAutoStart_Click"/>
                    <MenuItem Header="{DynamicResource TrayWorking}" IsCheckable="True"
                              x:Name="WorkingMenuItem" Click="TrayWorking_Click"/>
                    <MenuItem Header="{DynamicResource TrayExit}" Click="TrayExit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
        <StackPanel Margin="16">
            <!-- Статус -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#4CAF50" Margin="24,0,6,0" VerticalAlignment="Center">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 From="1" To="0.5" Duration="0:0:1.5" AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock x:Name="StatusText" Text="{DynamicResource StatusActive}" VerticalAlignment="Center"/>
                </StackPanel>

                <ui:AppBarButton Grid.Column="2" Icon="Pause" x:Name="ToggleButton"
                     Label="{DynamicResource BtnPause}" Click="ToggleButtonClick" Margin="0,0,24,0"/>
            </Grid>

            <!-- Пары -->
            <Border Background="#252525" Padding="0,0,0,8" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource PairsHeader}" 
                   FontWeight="SemiBold" Margin="20,16,0,8"/>
                    <Button Grid.Row="0" Grid.Column="1" Content="{DynamicResource AddPair}" 
                Margin="0,8,20,0" VerticalAlignment="Top" Click="AddPairClick"/>
                    <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" MaxHeight="120" 
                      VerticalScrollBarVisibility="Auto" Padding="12,0,0,0">
                        <StackPanel x:Name="PairsPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Исключения -->
            <Border Background="#252525" Padding="0,0,0,8" Margin="0,12,0,0" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource ExclusionsHeader}" 
                   FontWeight="SemiBold" Margin="20,16,0,8"/>
                    <Button Grid.Row="0" Grid.Column="1" Content="{DynamicResource AddExclusion}" 
                Margin="0,8,20,0" VerticalAlignment="Top" Click="AddExclusionClick"/>
                    <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" MaxHeight="160" 
                      VerticalScrollBarVisibility="Auto" Padding="12,0,0,0">
                        <StackPanel x:Name="ExclusionsPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>

        </StackPanel>
    </Grid>
</Window>
