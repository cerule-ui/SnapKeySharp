<Window x:Class="SnapKeySharp.Windows.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Update available" Height="285" Width="420"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel Margin="20">

            <!-- Шапка -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="⬆ " FontSize="20" VerticalAlignment="Center" Foreground="#4CAF50"/>
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="A new version of SnapKey is available." 
                       Foreground="#888" Margin="0,0,0,16"/>

            <!-- Changelog -->
            <Border Background="#1E1E1E" CornerRadius="6" Padding="12" Margin="0,0,0,20" MaxHeight="90">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ChangelogText" TextWrapping="Wrap" 
                   Foreground="#CCC" LineHeight="22"/>
                </ScrollViewer>
            </Border>

            <!-- Кнопки -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Later" Margin="0,0,8,0" Click="LaterClick"/>
                <Button Content="Update now" Click="UpdateClick"
                        Background="#4CAF50" Foreground="White" BorderThickness="0" Padding="16,8"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>